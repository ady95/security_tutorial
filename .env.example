# 이 파일을 .env 로 복사한 뒤 사용할 경로 하나만 남기세요.
# 코드는 OpenAI 호환 인터페이스 하나로 작성되어 있어, 아래 세 값만 바꾸면 됩니다.

# 경로 A (기본): Ollama 로컬 모델 — GPU 불필요, 무료
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3.5:4b
# 생각(thinking) 모드 끄기 — CPU에서 응답 시간을 수 분에서 수십 초로 줄인다
LLM_REASONING_EFFORT=none

# 경로 B (선택): OpenAI API — 유료, 결과가 더 안정적
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# LLM_REASONING_EFFORT=minimal
